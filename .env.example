# ---------------------------------------------------------------------------
# Market Analytics Dashboard — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) --------------------------------------------------
# Prisma connects to any Postgres via this single URL. That is the whole reason
# the "self-hosted vs Supabase" decision is NOT locked in — to switch providers
# you only change this line, no code changes.
#
# For HOST-based dev (running `npm run dev` / `npm run db:push` on your machine),
# point at the db container's PUBLISHED port. We publish it on 127.0.0.1:5433
# (NOT the default 5432) so it can't collide with any other Postgres on the box:
DATABASE_URL="postgresql://marketanalytic:marketanalytic@localhost:5433/marketanalytic?schema=public"
#
# NOTE: when the app runs INSIDE docker-compose it ignores the line above and
# uses the private network host `db:5432` (hard-set in docker-compose.yml).
# Nothing for you to change there.
#
# If you ever move to Supabase, paste their connection string here instead
# (use the "Connection pooling" / port 6543 string for the app, and the direct
#  5432 string for migrations via DIRECT_URL below).
# DIRECT_URL="postgresql://..."   # only needed for pooled providers like Supabase

# --- Host port bindings (collision-safe defaults) ---------------------------
# Both bind to 127.0.0.1 ONLY, so neither is ever exposed to the public internet
# (Nginx sits in front of the app). Non-default ports so they cannot clash with
# the ads / dashboard apps already running on this server.
APP_PORT_BIND="127.0.0.1:3100" # public app -> Nginx proxies your subdomain here
DB_PORT_BIND="127.0.0.1:5433"  # Postgres, localhost only

# --- Postgres container credentials (used by docker-compose) ----------------
# Fine as-is for local dev. On the VPS, change POSTGRES_PASSWORD to a strong,
# unique value (and update DATABASE_URL to match).
POSTGRES_USER="marketanalytic"
POSTGRES_PASSWORD="marketanalytic"
POSTGRES_DB="marketanalytic"

# --- App --------------------------------------------------------------------
NODE_ENV="development"

# --- Later milestones (not used in Milestone 1, listed here for reference) --
# Milestone 3/4 — AI column & sheet mapping, and Milestone 12 — AI insights:
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
#
# Milestone 9 — Auth (NextAuth):
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""   # generate with: openssl rand -base64 32
